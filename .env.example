# ── Portal identity ─────────────────────────────────────
PORTAL_TITLE=Dev Portal
TEAM_NAME=Platform Engineering
SITES_FILE=sites.json
PORT=5000
DEBUG=false


# ── SMB / CIFS share (installs) ──────────────────────────
# The Flask app uses smbprotocol to connect directly —
# no OS-level mount required (useful for k8s).
SMB_SERVER=fileserver.corp.local
SMB_SHARE=installs
SMB_BASE_PATH=
SMB_USER=svc-devportal
SMB_PASSWORD=changeme
SMB_DOMAIN=CORP
SMB_CACHE_TTL=60
